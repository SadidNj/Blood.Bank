@model blood.Models.Donor
@{
    ViewData["Title"] = "Delete";
}
<h1>Delete</h1>
<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Donor</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">FullName</dt>
        <dd class="col-sm-10">@Model.FullName</dd>
        <dt class="col-sm-2">BloodGroup</dt>
        <dd class="col-sm-10">@Model.BloodGroup</dd>
        <dt class="col-sm-2">ContactNo</dt>
        <dd class="col-sm-10">@Model.ContactNo</dd>
        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model.City</dd>
        <dt class="col-sm-2">LastDonationDate</dt>
        <dd class="col-sm-10">@Model.LastDonationDate</dd>
    </dl>
    <form action="/Donors/Delete/@Model.DonorId" method="post">
        <input type="hidden" name="id" value="@Model.DonorId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a href="/Donors">Back to List</a>
    </form>
</div>
