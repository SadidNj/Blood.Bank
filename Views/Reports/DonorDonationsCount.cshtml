@model IEnumerable<blood.Controllers.DonorDonationCountViewModel>
@{
    ViewData["Title"] = "Donor Donation Count";
}
<h1>Donor Donation Count</h1>
<table class="table">
    <thead>
        <tr>
            <th>FullName</th>
            <th>BloodGroup</th>
            <th>Total Donations</th>
        </tr>
    </thead>
    <tbody>
@foreach(var item in Model) {
        <tr>
            <td>@item.FullName</td>
            <td>@item.BloodGroup</td>
            <td>@item.DonationCount</td>
        </tr>
}
    </tbody>
</table>
